{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="ab-section ab-launch color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  aria-labelledby="AbLaunchHeading-{{ section.id }}"
>
  <div class="page-width">
    <header class="ab-section-head ab-section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ab-eyebrow" data-ab-reveal>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="AbLaunchHeading-{{ section.id }}" class="ab-display ab-section-head__title" data-ab-reveal>
          {{- section.settings.heading -}}
        </h2>
      </div>
    </header>

    <div class="ab-launch__grid ab-launch__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'launch' -%}
            {%- assign ab_product = block.settings.product -%}
            <article class="ab-launch__item ab-launch-card" {{ block.shopify_attributes }} data-ab-reveal>
              <a
                class="ab-launch-card__media"
                href="{{ ab_product.url | default: routes.all_products_collection_url }}"
                tabindex="-1"
                aria-hidden="true"
              >
                {%- assign ab_img = block.settings.image | default: ab_product.featured_image -%}
                {%- if ab_img != blank -%}
                  {{
                    ab_img
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '500, 750, 1000, 1400',
                      sizes: '(min-width: 990px) 50vw, 100vw',
                      class: 'ab-cover',
                      alt: ''
                  }}
                {%- else -%}
                  {{ 'product-3' | placeholder_svg_tag: 'ab-placeholder' }}
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="ab-tag">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </a>
              <div class="ab-launch-card__body">
                <div>
                  <h3 class="ab-launch-card__title">
                    <a href="{{ ab_product.url | default: routes.all_products_collection_url }}">
                      {{- ab_product.title | default: 'Choose a product' | escape -}}
                    </a>
                  </h3>
                  {%- if block.settings.note != blank -%}
                    <p class="ab-launch-card__note">{{ block.settings.note | escape }}</p>
                  {%- endif -%}
                </div>
                {%- if ab_product != blank -%}
                  {%- render 'price', product: ab_product, price_class: 'ab-launch-card__price', show_compare_at_price: true -%}
                {%- endif -%}
              </div>
            </article>

          {%- when 'promo' -%}
            <article
              class="ab-launch__item ab-promo color-{{ block.settings.color_scheme }} gradient{% if block.settings.image != blank %} ab-promo--has-image{% endif %}"
              {{ block.shopify_attributes }}
              data-ab-reveal
            >
              {%- if block.settings.image != blank -%}
                <div class="ab-promo__image" aria-hidden="true">
                  {{
                    block.settings.image
                    | image_url: width: 1000
                    | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 990px) 25vw, 60vw', class: 'ab-cover', alt: ''
                  }}
                </div>
              {%- endif -%}
              <div class="ab-promo__content">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="ab-eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                <h3 class="ab-display ab-promo__heading">{{ block.settings.heading }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="ab-promo__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
              <div class="ab-promo__footer">
                {%- if block.settings.code != blank -%}
                  <ab-copy-code
                    class="ab-code"
                    data-code="{{ block.settings.code | escape }}"
                    data-copied="Copied"
                  >
                    <span class="ab-code__value">{{ block.settings.code | escape }}</span>
                    <button type="button" class="ab-code__button">
                      Copy<span class="visually-hidden"> code {{ block.settings.code | escape }}</span>
                    </button>
                    <span class="ab-code__status" data-copy-status role="status" aria-live="polite"></span>
                  </ab-copy-code>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a class="ab-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
                    {{- block.settings.button_label | escape }}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                {%- endif -%}
              </div>
            </article>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Atelier · New & offers",
  "tag": "div",
  "class": "section-ab-launch",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Just arrived"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "New <em>&amp;</em> now"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "launch",
      "name": "New arrival",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Defaults to the product image."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tag",
          "default": "New"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "A limited run of four lacquered shades."
        }
      ]
    },
    {
      "type": "promo",
      "name": "Promotion",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Members' offer"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "15% off your <em>first</em> ritual"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Demo offer for portfolio purposes. Create a matching discount in Shopify admin to make it work at checkout."
        },
        {
          "type": "text",
          "id": "code",
          "label": "Discount code",
          "info": "Must match a discount created in Shopify admin › Discounts.",
          "default": "ATELIER15"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier · New & offers",
      "blocks": [
        { "type": "launch" },
        { "type": "promo" },
        { "type": "launch", "settings": { "note": "Weightless glow in three light-catching tones." } }
      ]
    }
  ]
}
{% endschema %}
